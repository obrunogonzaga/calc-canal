# Set only after the production domain is owned and configured.
# Without this value the preview is noindex and no production canonical is claimed.
# NEXT_PUBLIC_SITE_URL=https://precopronto.com.br

# Authentication stays disabled until the server dependencies below are ready.
AUTH_ENABLED=false
BETTER_AUTH_URL=http://localhost:3101
# Optional legacy alias. If set, it must match BETTER_AUTH_URL exactly.
# AUTH_BASE_URL=http://localhost:3101
# Generate a distinct secret with at least 32 characters. Never commit it.
# BETTER_AUTH_SECRET=
# DATABASE_URL=postgres://user:password@127.0.0.1:55432/precopronto_local
# TEST_DATABASE_URL=postgres://user:password@127.0.0.1:55432/precopronto_integration

# Local SMTP is allowed only with loopback host and loopback auth URL.
APP_ENV=local
SMTP_HOST=127.0.0.1
SMTP_PORT=11025
SMTP_SECURE=false
SMTP_FROM="PreçoPronto <nao-responda@precopronto.test>"
# SMTP_USER=
# SMTP_PASSWORD=

# List exact proxy IPs or narrow CIDRs only after the origin is reachable
# exclusively through them. Do not use broad private ranges.
# AUTH_TRUSTED_PROXIES=

# Checkout de teste somente em ambiente não produtivo. Sandbox e Produção
# usam contas e chaves diferentes; nunca use a chave real nesta integração.
BILLING_SANDBOX_ENABLED=false
# ASAAS_ENV=sandbox
# ASAAS_SANDBOX_API_KEY=
# Origem HTTPS pública das páginas de retorno do Checkout (sem caminho).
# ASAAS_SANDBOX_CALLBACK_ORIGIN=https://teste.exemplo.com
# Gere um segredo próprio de 32 a 255 caracteres para o Webhook.
# ASAAS_SANDBOX_WEBHOOK_TOKEN=
# Id da conta Sandbox esperado nos Webhooks.
# ASAAS_SANDBOX_ACCOUNT_ID=
