# Copy to .env beside compose.yaml. Never commit the real file.
# Use the exact reviewed Git commit SHA as the image tag.
LIQUIDO_IMAGE_TAG=replace-with-reviewed-commit-sha
# Generate locally with htpasswd -nbB and store the resulting user:hash here.
# Single quotes keep bcrypt dollar signs literal during Compose interpolation.
LIQUIDO_BASIC_AUTH='replace-with-user-and-bcrypt-hash'
